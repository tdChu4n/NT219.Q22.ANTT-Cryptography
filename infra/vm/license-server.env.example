# Runtime config for license-server on VM.
# Copy to /etc/nt219/license-server.env and chmod 600.

NODE_ENV=production
PORT=3000

# Use MONGO_URI, not MONGO_URL. The server reads process.env.MONGO_URI.
MONGO_URI=mongodb://nt219_app:CHANGE_ME@VM_DB_PRIVATE_IP:27017/drm_platform
DB_NAME=drm_platform

# 64 hex chars. Generate: openssl rand -hex 32
KMS_MASTER_KEY=CHANGE_ME_64_HEX_CHARS

# Generate: openssl rand -hex 32
JWT_HS256_SECRET=CHANGE_ME_STRONG_SECRET
