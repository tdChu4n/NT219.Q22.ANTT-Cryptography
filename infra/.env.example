# Sao chép file này thành .env rồi điền giá trị thực
# cp infra/.env.example infra/.env

# Node environment (production | development)
NODE_ENV=production

# AES-256 Master Key — 64 ký tự hex (32 bytes)
# Sinh: openssl rand -hex 32
KMS_MASTER_KEY=CHANGE_ME_64_HEX_CHARS_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT HS256 secret (dùng cho internal service nếu cần)
# Sinh: openssl rand -hex 32
JWT_HS256_SECRET=CHANGE_ME_STRONG_SECRET
